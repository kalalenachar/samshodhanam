# Telegram bot token — get from @BotFather on Telegram
TELEGRAM_OCR_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Telegram username of the Sanskrit STT bot (without @)
SANSKRIT_STT_BOT_USERNAME="YOUR_BOT_USERNAME_HERE"
