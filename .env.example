# =============================================================================
# Open-Samsho (संशोधन मन्दिरम्) — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' before starting the server:
#   cp .env.example .env
#
# NEVER commit the actual '.env' file containing real secrets to version control.
# =============================================================================

# Flask session and encryption key (REQUIRED in production)
# Generate a secure 32-byte secret key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-32-byte-secret-key-here

# Server port for unified portal gateway (default: 5001)
PORT=5001

# AI & Semantic Vector Search (Google Gemini) — Optional
# Enables conceptual manuscript search and AI-assisted proofreading
GEMINI_API_KEY=

# Google OAuth Sign-in Client ID — Optional
# Enables 1-click Google authentication on the reader and portal
GOOGLE_CLIENT_ID=

# Email notifications (SMTP) — Optional
# Used for user registration OTPs and volunteer proofreading notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Telegram Bots Configuration — Optional
# Get tokens from @BotFather on Telegram if deploying standalone bot workers
TELEGRAM_OCR_BOT_TOKEN=
TELEGRAM_STT_BOT_TOKEN=
TELEGRAM_TRANSLIT_BOT_TOKEN=

# Internal / Standalone Service Endpoints (Defaults to local unified portal)
SAMSHO_OCR_API_URL=http://localhost:5001/api/v1/ocr
SAMSHO_OCR_API_KEY=
SAMSHO_STT_API_URL=http://localhost:5001/api/v1/stt
SAMSHO_STT_API_KEY=
SAMSHO_NLP_API_URL=http://localhost:5001/apps/api
SAMSHO_NLP_API_KEY=
